# ===== 必填 =====
HOST=0.0.0.0
PORT=8001
DEBUG=false

# 数据库（SQLite 即可）
DATABASE_URL=sqlite+aiosqlite:///./data/image_gen.db
DB_POOL_SIZE=64
DB_MAX_OVERFLOW=64
DB_POOL_TIMEOUT_SECONDS=60

# 加密密钥（Fernet，必须替换；可用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成）
ENCRYPTION_KEY=replace-with-fernet-key

# JWT 密钥 (必须替换, 请使用强随机字符串，可通过 openssl rand -hex 32 生成)
JWT_SECRET_KEY=replace-with-random-jwt-secret
JWT_EXPIRE_HOURS=24

# 普通用户会话（邀请码激活后使用）
USER_SESSION_COOKIE_NAME=st_imagen_session
USER_SESSION_DAYS=30
# 生产环境应为 true；仅本地 http 调试时改成 false
USER_SESSION_SECURE=true
USER_SESSION_SAMESITE=lax
# USER_SESSION_DOMAIN=

# 邀请码默认给新用户的额度/并发（创建邀请码时可覆盖）
DEFAULT_USER_DAILY_QUOTA=0
DEFAULT_USER_MAX_INFLIGHT=2

# 管理员初始账号（首次启动后请改密）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# 管理后台路径（可自定义隐藏入口；未设置时默认 /admin）
ADMIN_PATH=admin

# ===== 上游 =====
STACKAI_BASE_URL=https://api.stack-ai.com
STACKAI_TIMEOUT_SECONDS=240
STACKAI_CONNECT_TIMEOUT_SECONDS=10
# 传输层保护时间要大于工作流等待时间，避免底层连接先断开
STACKAI_STREAM_READ_TIMEOUT_SECONDS=300
# 工作流总预算 200s；普通工作流无进度 90s；GPT Image 2 和 Nano 4K 单独允许 150s
GENERATE_STREAM_IDLE_TIMEOUT_SECONDS=90
GENERATE_STREAM_TOTAL_TIMEOUT_SECONDS=200
GENERATE_STREAM_TEXT2IMG_4K_IDLE_TIMEOUT_SECONDS=150
GENERATE_STREAM_GPT_IMAGE_2_IDLE_TIMEOUT_SECONDS=150
# 是否遵循 HTTP(S)_PROXY / NO_PROXY；某些网络出口直连 api.stack-ai.com 会返回 403
STACKAI_TRUST_ENV=true

# ===== CORS =====
# 同源部署留空；跨域时填精确源，例如 https://img.example.com
CORS_ORIGINS=
# 当 CORS_ORIGINS 配成精确源且前端需要带 cookie/Authorization 时，再显式设为 true
CORS_ALLOW_CREDENTIALS=false

# ===== Public URL =====
# 部署到 VPS / 反代后，请改成用户最终访问这个服务的公网地址。
# 例如：https://img.example.com/
PUBLIC_BASE_URL=

# ===== Upload Cleanup（多用户部署建议开启，防止磁盘写满；全部为 0 = 清理关闭） =====
REFERENCE_UPLOAD_RETENTION_DAYS=7
GENERATED_IMAGE_RETENTION_DAYS=7
REFERENCE_UPLOAD_DIR_MAX_FILES=2000
GENERATED_IMAGE_DIR_MAX_FILES=3000
UPLOAD_CLEANUP_INTERVAL_SECONDS=300

# ===== 流量守卫（进程内状态，要求 UVICORN_WORKERS=1；设 0 关闭对应项） =====
# 全局同时在途的生图请求数上限
GENERATION_GLOBAL_MAX_CONCURRENT=64
# 全局闸门等待秒数，超时返 429
GENERATION_GLOBAL_WAIT_SECONDS=5
# 每用户每分钟生图请求上限
USER_RPM_LIMIT=12
# 上游连续失败 N 次后熔断 M 秒（期间生图直接 503，防故障放大）
CIRCUIT_BREAKER_FAILURES=6
CIRCUIT_BREAKER_OPEN_SECONDS=30
# 管理员登录连续失败锁定
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_SECONDS=60
# 多张生成图的并行下载数
GENERATED_IMAGE_DOWNLOAD_CONCURRENCY=3

# st-imagen 核心部署配置
# 复制为 .env 后，至少修改 ENCRYPTION_KEY、JWT_SECRET_KEY、ADMIN_PASSWORD。
# HOST：服务监听地址。0.0.0.0 表示监听所有网卡；反向代理部署通常保持此值。
HOST=0.0.0.0
# PORT：本服务监听端口；反向代理 upstream 必须指向同一个端口。
PORT=8001
# DEBUG：调试模式。生产环境保持 false，避免过多日志和调试信息。
DEBUG=false
# UVICORN_WORKERS：worker 进程数。必须保持 1，因为并发计数和账号槽位保存在进程内。
UVICORN_WORKERS=1

# 数据库与安全密钥
# DATABASE_URL：SQLite 数据库地址；相对路径相对于项目工作目录。
DATABASE_URL=sqlite+aiosqlite:///./data/image_gen.db
# ENCRYPTION_KEY：加密保存 StackAI API Key 的 Fernet 密钥；修改后旧账号密钥无法解密。
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key
# JWT_SECRET_KEY：管理员/用户会话令牌签名密钥；必须使用随机长字符串，修改会使旧令牌失效。
JWT_SECRET_KEY=replace-with-random-jwt-secret
# JWT_EXPIRE_HOURS：JWT 令牌有效期，单位为小时；不等于单次生图超时。
JWT_EXPIRE_HOURS=24
# ADMIN_USERNAME：首次启动创建默认管理员时使用的用户名；已有管理员不会被自动覆盖。
ADMIN_USERNAME=admin
# ADMIN_PASSWORD：首次启动创建默认管理员时使用的密码；生产环境必须修改，创建后建议在后台改密。
ADMIN_PASSWORD=replace-with-strong-admin-password
# ADMIN_PATH：管理后台 URL 路径，不带斜杠；留空时使用 /admin。它只是入口路径，不替代认证。
ADMIN_PATH=admin

# 用户会话与默认用户限制
# USER_SESSION_COOKIE_NAME：浏览器用户会话 Cookie 名称；同域运行多个实例时应避免重名。
USER_SESSION_COOKIE_NAME=st_imagen_session
# USER_SESSION_DAYS：用户会话最长存活时间，单位为天；不等于生图请求超时。
USER_SESSION_DAYS=30
# USER_SESSION_SECURE：是否只允许 HTTPS 发送 Cookie。生产 HTTPS 使用 true；本机 HTTP 调试改为 false。
USER_SESSION_SECURE=true
# USER_SESSION_SAMESITE：Cookie 跨站策略，通常使用 lax；跨站嵌入才考虑 none/strict。
USER_SESSION_SAMESITE=lax
# USER_SESSION_DOMAIN：Cookie 作用域；留空表示当前主机，跨子域共享时才填写。
USER_SESSION_DOMAIN=
# DEFAULT_USER_DAILY_QUOTA：新建用户的每日生图额度，单位为请求数；0 表示不限制。
DEFAULT_USER_DAILY_QUOTA=10
# DEFAULT_USER_MAX_INFLIGHT：单个用户同时进行的生图请求数上限；不同于账号并发和全局并发。
DEFAULT_USER_MAX_INFLIGHT=2

# StackAI 上游
# STACKAI_BASE_URL：StackAI API 基础地址，不要填写具体 inference 路径。
STACKAI_BASE_URL=https://api.stack-ai.com
# STACKAI_TIMEOUT_SECONDS：上游 HTTP 传输层总超时下限，单位为秒；应高于工作流总时限。
STACKAI_TIMEOUT_SECONDS=270
# STACKAI_CONNECT_TIMEOUT_SECONDS：建立 TCP/TLS 连接的超时时间，单位为秒；只管连接建立。
STACKAI_CONNECT_TIMEOUT_SECONDS=10
# STACKAI_STREAM_READ_TIMEOUT_SECONDS：SSE 两次读取之间允许的最长无数据时间，单位为秒；不是工作流总时限。
STACKAI_STREAM_READ_TIMEOUT_SECONDS=330
# STACKAI_TRUST_ENV：是否读取 HTTP(S)_PROXY 等系统代理变量；服务器不需要代理时设为 false。
STACKAI_TRUST_ENV=true

# 并发准入与连接池：满载直接 HTTP 429，不在服务端排队
# GENERATION_GLOBAL_MAX_CONCURRENT：单 worker 内所有模型共享的生图槽位；满载立即返回 429。
GENERATION_GLOBAL_MAX_CONCURRENT=90
# ACCOUNT_MAX_INFLIGHT：新建账号默认并发上限；已有账号可在后台单独设置，不是全局并发。
ACCOUNT_MAX_INFLIGHT=10
# HTTP_MAX_CONNECTIONS：本进程对外 HTTP 连接池总上限；不是生图请求上限。
HTTP_MAX_CONNECTIONS=128
# HTTP_MAX_KEEPALIVE：HTTP 连接池保持复用的空闲连接上限；应小于或等于 HTTP_MAX_CONNECTIONS。
HTTP_MAX_KEEPALIVE=128
# DB_POOL_SIZE：SQLite 异步数据库常驻连接数；只影响数据库访问，不影响 StackAI 并发。
DB_POOL_SIZE=4
# DB_MAX_OVERFLOW：数据库连接池临时扩容数；0 表示不扩容，避免放大 SQLite 写竞争。
DB_MAX_OVERFLOW=0
# DB_POOL_TIMEOUT_SECONDS：等待数据库连接的时间，单位为秒；不是生图排队时间。
DB_POOL_TIMEOUT_SECONDS=3

# 图片存储与本地落盘
# UPLOADS_DIR：参考图和生成图片的根目录；生成图片保存到 generated 子目录。
UPLOADS_DIR=./data/uploads
# GENERATED_IMAGE_MIN_FREE_BYTES：磁盘安全预留空间8G，单位为字节；空间不足时拒绝图片落盘。
GENERATED_IMAGE_MIN_FREE_BYTES=8589934592
# GENERATED_IMAGE_DOWNLOAD_CONCURRENCY：上游生成完成后的图片下载/落盘并发数；不占生图槽位。
GENERATED_IMAGE_DOWNLOAD_CONCURRENCY=32

# 对外地址与跨域
# PUBLIC_BASE_URL：本站公网根地址，例如 https://img.example.com；用于返回图片地址和提供 StackAI 访问参考图。
PUBLIC_BASE_URL=
# CORS_ORIGINS：允许访问本服务的前端来源，多个来源用逗号分隔；同源部署留空，生产优先填写精确域名。
CORS_ORIGINS=
# CORS_ALLOW_CREDENTIALS：是否允许跨域携带 Cookie；CORS_ORIGINS 使用 * 时必须为 false。
CORS_ALLOW_CREDENTIALS=false

# 少量高级配置（按需取消注释；图片保留期优先在管理后台设置）
# ACCOUNT_FAILURE_ISOLATION_SECONDS=300
#   账号故障隔离时长，单位秒；只隔离密钥/账号配置等明确账号故障，不是账号并发冷却。
# USER_RPM_LIMIT=12
#   单用户每分钟请求数上限；0 表示关闭。它限制请求频率，不占用和不改变并发槽位。
# CIRCUIT_BREAKER_FAILURES=6
#   全局上游连续失败次数阈值；达到后触发快速失败。
# CIRCUIT_BREAKER_OPEN_SECONDS=30
#   全局熔断保持打开的时间，单位秒；与账号故障隔离时长无关。
# GENERATE_STREAM_IDLE_TIMEOUT_SECONDS=150
#   普通工作流连续无进度超时，单位秒；不是从请求开始计算的总时限。
# GENERATE_STREAM_TOTAL_TIMEOUT_SECONDS=230
#   单次工作流从开始到结束的总时限，单位秒；应大于普通 idle timeout。
# GENERATE_STREAM_KEEPALIVE_INTERVAL_SECONDS=15
#   服务端向浏览器发送 SSE 保活注释的间隔，单位秒；只保持连接，不延长上游工作流总时限。
# GENERATED_IMAGE_TIMEOUT_SECONDS=60
#   单张结果图片下载的单次 HTTP 超时，单位秒；不影响 StackAI 生图工作流。
# GENERATED_IMAGE_SAVE_TOTAL_TIMEOUT_SECONDS=75
#   一次请求保存全部结果图片的总预算，单位秒；应不小于单张下载超时。
